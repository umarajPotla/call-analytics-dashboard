    {
      "id": 11,
      "type": "timeseries",
      "title": "Ingested events by outcome",
      "description": "applied = changed a call · duplicate = same event id again · noop = older than current state · rejected = invalid",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (outcome) (rate(ingest_events_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 35,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
