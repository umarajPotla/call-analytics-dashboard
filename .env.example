# Copy to .env for local runs outside Docker. Never commit real secrets.
# `docker compose up db` publishes Postgres on localhost:5433 (not 5432, to avoid clashing with a local install).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/calls
# Direct (non-pooled) URL used for LISTEN/NOTIFY. Same as DATABASE_URL locally; on Neon use the non-pooled host.
DATABASE_URL_DIRECT=
PORT=8080
LOG_LEVEL=info
# Simulator: generates realistic traffic through the public ingest API
SIM_ENABLED=true
SIM_SEED=42
SIM_BACKFILL_DAYS=14
SIM_RATE_MULTIPLIER=1
SIM_DUPLICATE_RATE=0.02
SIM_REORDER_RATE=0.01
# Demo controls (spike button). Off in real deployments.
DEV_TOOLS=true
# AI insights: any OpenAI-compatible endpoint. Leave LLM_BASE_URL empty to use the deterministic template.
# Ollama (local):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2:3b
# Gemini (hosted): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.5-flash  LLM_API_KEY=...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=8000
# Price table for the cost meter (USD per million tokens). 0 on free tiers; the metric still works.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
# LLM generations allowed per account per hour (beyond this the template answers).
INSIGHTS_LLM_BUDGET_PER_HOUR=30
